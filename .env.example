# Copy this file to .env.local for local development.
#
#   cp .env.example .env.local
#
# .env.local is gitignored. For the live site these same names are set as
# GitHub repository VARIABLES (not secrets) and passed through by
# .github/workflows/nextjs.yml.
#
# Everything here is NEXT_PUBLIC_*, meaning the value is baked into the static
# build and visible in page source. That is correct for all four: a GA
# measurement ID and site-verification tokens are public by design. Never put
# an actual secret behind a NEXT_PUBLIC_ name.

# The canonical origin. Every canonical URL, OG tag, sitemap entry and
# schema @id is built from this. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://syedsafwan.dev

# Google Analytics 4 measurement ID.
# Get it: analytics.google.com -> Admin -> Data Streams -> your web stream.
# Leave blank and no analytics script is emitted at all.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification token.
# Get it: search.google.com/search-console -> Add property -> URL prefix ->
# "HTML tag" method. Copy ONLY the content="..." value, not the whole tag.
# Not needed if you verify by DNS TXT record instead (which is more durable).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification token.
# Get it: bing.com/webmasters -> Add site -> "HTML Meta Tag".
# Copy only the content="..." value. Feeds Bing and, indirectly, Copilot.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
